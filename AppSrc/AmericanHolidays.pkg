//****************************************************************************
// $Module type: Package
// $Module name: AmericanHolidays.pkg
// $Author     : Nils Svedmyr
// Created     : 2010-11-29 @ 06:23
//
// Description : Function that returns the name of American (US) holidays from a date variable.
//
// Note        : To create a similar package for another country, copy the function below and
//               simply change the name and wordings and possibly also what should constitute the holidays
//               for your country. All the underlying holiday functions can be found in oCalendarHolidays.pkg
//               The HolidayName function is used by the Holidays.vw sample view; the oCreateDates_bp business process.
//
// $Rev History:
//    2010-11-29 Module header created
//
//
//****************************************************************************
Use cNationalHolidays.pkg

Object oAmericanHolidays is a cNationalHolidays

    // A 2-character ISO_Short string, according to the list:
    // https://www.iso.org/obp/ui/#search/code/
    Set psISO_Short to "US"
    Set psLocaleName to "en-US"    // the month and day names in the country's language

    // THE DAYS (2026-11-26): looked up in this order - the first that falls on a date names it, so when two fall on
    // the same date the one listed first wins. AddDay gives a day by one of the library's date functions
    // (oCalendarHolidays.pkg), AddFixedDay by its month and day; the last argument is True for an official holiday -
    // a day off by law - and False for a special day that is not. HolidayName and IsDateAHoliday both read this list
    // (cNationalHolidays.pkg).

    // *** Fixed 'Holidays' ***
    Send AddDay "NewYearsEve" "New Year's Eve" False
    Send AddDay "NewYearsDay" "New Year's Day" True
    Send AddDay "MLKDay" "Martin Luther King, Jr. Day" True
    Send AddDay "PresidentsDay" "President's Day" True
    Send AddDay "MemorialDay" "Memorial Day" True
    Send AddDay "LaborDay" "Labor Day" True
    Send AddDay "ColumbusDay" "Columbus Day" True
    Send AddDay "VeteransDay" "Veterans Day" True
    Send AddDay "Epiphany" "Twelfthday (Epiphany)" False
    Send AddDay "Halloween" "Halloween" False
    Send AddDay "FeastOfChristTheKing" "Feast of Christ the King" False
    Send AddDay "ChristmasEve" "Christmas Eve" False
    Send AddDay "Advent1" "Advent Sunday" False
    Send AddDay "Advent2" "2nd Advent Sunday" False
    Send AddDay "Advent3" "3d Advent Sunday" False

    // This needs to be after ChristMasEve because it can fall on the same day, and we then wants to return Christmas Eve instead.
    Send AddDay "Advent4" "4th Advent Sunday" False
    Send AddDay "ChristmasDay" "Christmas" True
    Send AddDay "NationalDay" "Independence Day" True

    // Juneteenth National Independence Day, the 19th of June: a federal holiday since 2021. On a Saturday it
    // is observed on the Friday before, on a Sunday on the Monday after.
    Send AddFixedDay 6 19 "Juneteenth" True
    Send SetDayYears 2021 0
    Send AddFixedDay 6 19 "Juneteenth (observed)" True
    Send SetDayYears 2021 0
    Send SetDayOffset -1 6
    Send AddFixedDay 6 19 "Juneteenth (observed)" True
    Send SetDayYears 2021 0
    Send SetDayOffset 1 7

    // *** New 2010-03-30 NGS ***
    // This is an example on how to add a 'holiday'
    // for any special day that you might
    // want to include in a e.g. holidays date table.
    // The International Women's Day falls each year on the 8th of March:
    //    Send AddFixedDay 3 8 "International Women's Day" False

    // Valentine's Day - 14th February
    Send AddDay "ValentinesDay" "Valentine's Day" False
    Send AddDay "SaintPatricksDay" "Saint Patrick's Day" False
    Send AddDay "AprilFoolsDay" "April Fools' Day" False

    // *** Movable holidays ***
    // Easter functions at the bottom; they are the most complicated to calculate.
    Send AddDay "Thanksgiving" "Thanksgiving Day" True
    Send AddDay "AshWednesday" "Ash Wednesday" False
    Send AddDay "PalmSunday" "Palm Sunday" False
    Send AddDay "AscensionDay" "Ascension Day" False
    Send AddDay "WhitSunday" "Whit Sunday" False
    Send AddDay "WhitMonday" "Whit Monday" False
    Send AddDay "AllSaintsDay" "All Saints Day" False
    Send AddDay "MaundyThursday" "Maundy Thursday" False
    Send AddDay "GoodFriday" "Good Friday" False
    Send AddDay "HolySaturday" "Holy Saturday" False
    Send AddDay "EasterDay" "Easter Day" False
    Send AddDay "EasterMonday" "Easter Monday" False
    Send AddDay "FlagDay" "Flag Day" False
    Send AddDay "PatriotsDay" "Patriot Day" False
    Send AddDay "ConstitutionDay" "Constitution/Citizenship Day" False
    Send AddDay "LeifEriksonDay" "Leif Erikson Day" False
    Send AddDay "GroundHogDay" "Ground Hog Day" False

    // Spring Equinox
    Send AddDay "VernalEquinox" "Spring Equinox" False

    // Autumn Equinox
    Send AddDay "AutumnalEquinox" "Autumn Equinox" False

    // This day needs to be _after_ the WhitSunday.
    // So when WhitSunday falls on the last Sunday in May,
    // only the WhitSunday will get generated. Else the
    // Mother's Day would show up at that day.
    Send AddDay "MothersDay" "Mothers Day" False
    Send AddDay "FathersDay" "Fathers Day" False

End_Object
