//****************************************************************************
// $Module type: Package
// $Module name: NorwegianHolidays.pkg
// $Author     : Ola Eldoy
// Created     : 2011-02-22 @ 08:00
//
// Description : Function that returns the name of Norwegian holidays and special days from a date variable.
//
// Note        : To create a similar package for another country, copy the function below and
//               simply change the name and wordings and possibly also what should constitute the holidays
//               for your country. All the underlying holiday functions can be found in oCalendarHolidays.pkg
//               The HolidayName function is used by the Holidays.vw sample view; the oCreateDates_bp business process.
//
// $Rev History:
//    2010-03-22 Module header created
//
//    2010-03-30 Added functionality to make it easier to add just about any 'special day'
//               that you might want to add to a Is????Holiday function. (were ???? is the country name)
//               Look for comment: *** New 2010-03-30 NGS ***
//
//
//****************************************************************************
Use cNationalHolidays.pkg

Object oNorwegianHolidays is a cNationalHolidays
    Move Self to ghoNationalHolidayObject

    // A 2-character ISO_Short string, according to the list:
    // https://www.iso.org/obp/ui/#search/code/
    Set psISO_Short to "NO"
    Set psLocaleName to "nb-NO"    // the month and day names in the country's language

    // THE DAYS (2026-11-26): looked up in this order - the first that falls on a date names it, so when two fall on
    // the same date the one listed first wins. AddDay gives a day by one of the library's date functions
    // (oCalendarHolidays.pkg), AddFixedDay by its month and day; the last argument is True for an official holiday -
    // a day off by law - and False for a special day that is not. HolidayName and IsDateAHoliday both read this list
    // (cNationalHolidays.pkg).

    // *** Fixed Holidays ***
    Send AddDay "NewYearsEve" "nyttårsaften" False
    Send AddDay "NewYearsDay" "1. nyttårsdag" True
    Send AddDay "LaborDay" "offentlig høytidsdag" True
    Send AddDay "ChristmasEve" "julaften" False
    Send AddDay "ChristmasDay" "1. juledag" True
    Send AddDay "SecondDayChristmas" "2. juledag" True
    Send AddDay "NationalDay" "grunnlovsdag" True

    // This is an example on how to add a 'holiday'
    // for any special day that you might
    // want to include in a e.g. holidays date table.
    // The International Women's Day falls each year on the 8th of March.
    Send AddFixedDay 3 8 "kvinnedagen" False  // 8th of March.
    Send AddFixedDay 5 8 "frigjøringsdag" False  // 8th of May: Liberation day

    // *** Movable holidays ***
    // Easter functions at the bottom; they are the most complicated to calculate.
    Send AddDay "PalmSunday" "palmesøndag" True
    Send AddDay "AscensionDay" "Kristi Himmelfartsdag" True
    Send AddDay "WhitSunday" "1. pinsedag" True
    Send AddDay "WhitMonday" "2. pinsedag" True
    Send AddDay "MidsummerDay" "sankthans" False
    Send AddDay "MaundyThursday" "skjærtorsdag" True
    Send AddDay "GoodFriday" "langfredag" True
    Send AddDay "HolySaturday" "påskeaften" False
    Send AddDay "EasterDay" "1. påskedag" True
    Send AddDay "EasterMonday" "2. påskedag" True

    // Vårdagjämning
    Send AddDay "VernalEquinox" "Vårjevndøgn" False

    // Höstdagjämning
    Send AddDay "AutumnalEquinox" "Høstjevndøgn" False

    // This needs to be after all easter days.
    // So when April fools day falls on one of the easter days,
    // an easter day will be returned instead. (More imporant)
    Send AddDay "AprilFoolsDay" "1. april" False
End_Object
