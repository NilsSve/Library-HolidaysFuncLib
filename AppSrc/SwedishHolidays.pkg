//****************************************************************************
// $Module type: Package
// $Module name: SwedishHolidays.pkg
// $Author     : Nils Svedmyr
// Created     : 2010-03-22 @ 06:23
//
// Description : Function that returns the name of Swedish holidays and special days from a date variable.
//
// Note        : To create a similar package for another country, copy the function below and
//               simply change the name and wordings and possibly also what should constitute the holidays
//               for your country. All the underlying holiday functions can be found in oCalendarHolidays.pkg
//               The HolidayName function is used by the Holidays.vw sample view; the oCreateDates_bp business process.
//
// $Rev History:
//    2010-03-22 Module header created
//
//    2010-03-30 Added functionality to make it easier to add just about any 'special day'
//               that you might want to add to a Is????Holiday function. (were ???? is the country name)
//               Look for comment: *** New 2010-03-30 NGS ***
//
//
//****************************************************************************
Use cNationalHolidays.pkg

Object oSwedishHolidays is a cNationalHolidays

    // A 2-character ISO_Short string, according to the list:
    // https://www.iso.org/obp/ui/#search/code/
    Set psISO_Short to "SE"
    Set psLocaleName to "sv-SE"    // the month and day names in the country's language

    // The calendar's words in the country's language (cCalendarHolidays' CountryWords; English where not set).
    Set psTextWeek             to "V"
    Set psTextWorkingDaysNote  to "%1 arbetsdagar"
    Set psTextHoliday          to "Helgdag, ledig"
    Set psTextHolidayWeekend   to "Helgdag på helgen"
    Set psTextSpecial          to "Särskild dag, arbetsdag"
    Set psTextSpecialWeekend   to "Särskild dag, helg"
    Set psTextWeekend          to "Ledig varje vecka"
    Set psTextClosed           to "Stängt"
    Set psTextClosedDay        to "Stängd dag"
    Set psTextWorkingDay       to "Arbetsdag"

    // THE DAYS (2026-11-26): looked up in this order - the first that falls on a date names it, so when two fall on
    // the same date the one listed first wins. AddDay gives a day by one of the library's date functions
    // (oCalendarHolidays.pkg), AddFixedDay by its month and day; the last argument is True for an official holiday -
    // a day off by law - and False for a special day that is not. HolidayName and IsDateAHoliday both read this list
    // (cNationalHolidays.pkg).

    // *** Fixed Holidays ***
    Send AddDay "NewYearsEve" "Nyårsafton" False
    Send AddDay "NewYearsDay" "Nyårsdagen" True
    Send AddDay "EpiphanyEve" "Trettondagsafton" False
    Send AddDay "Epiphany" "Trettondagen" True
    Send AddDay "ValborgsEve" "Valborgsmässoafton" False
    Send AddDay "LaborDay" "Arbetarrörelsens dag" True
    Send AddDay "FeastOfChristTheKing" "Domsöndagen" False
    Send AddDay "ChristmasEve" "Julafton" False
    Send AddDay "Advent1" "1:a Advent" False
    Send AddDay "Advent2" "2:a Advent" False
    Send AddDay "Advent3" "3:e Advent" False

    // This needs to be after ChristMasEve because it can fall on the same day, and we then wants to return Christmas Eve instead.
    Send AddDay "Advent4" "4:e Advent" False
    Send AddDay "ChristmasDay" "Juldagen" True
    Send AddDay "SecondDayChristmas" "Annandag Jul" True
    Send AddDay "EpiphanyEve" "Trettondagsafton" False
    Send AddDay "Epiphany" "Trettondagen (Tretton dagar efter jul)" False
    Send AddDay "TwentiethKnut" "20:e Knut (Julgransplundring)" False

    // A public holiday since 2005, when it replaced Whit Monday (Annandag pingst).
    Send AddDay "NationalDay" "Sveriges nationaldag" True
    Send SetDayYears 2005 0
    Send AddDay "NationalDay" "Sveriges nationaldag" False
    Send SetDayYears 0 2004

    // *** New 2010-03-30 NGS ***
    // This is an example on how to add a 'holiday'
    // for any special day that you might
    // want to include in a e.g. holidays date table.
    // The International Women's Day falls each year on the 8th of March.
    Send AddFixedDay 3 8 "Internationella Kvinnodagen" False  // 8th of March.
    Send AddFixedDay 2 14 "Alla Hjärtans dag" False  // 14th of February.

    // *** Movable holidays ***
    Send AddDay "PalmSunday" "Palmsöndagen" False
    Send AddDay "AscensionDay" "Kristi himmelsfärd" True
    Send AddDay "WhitSunday" "Pingstdagen" True

    // A public holiday until 2004; the National Day (6 June) replaced it in 2005.
    Send AddDay "WhitMonday" "Annandag Pingst" True
    Send SetDayYears 0 2004
    Send AddDay "WhitMonday" "Annandag Pingst" False
    Send SetDayYears 2005 0
    Send AddDay "MidsummerDay" "Midsommardagen" True
    Send AddDay "MidsummerEve" "Midsommarafton" False
    Send AddDay "AllSaintsDay" "Alla helgons dag" True
    Send AddDay "AllSaintsDayEve" "All helgona afton" False

    // Needs to be defined after the AllSaintsDay test.
    Send AddDay "Halloween" "Halloween" False
    Send AddDay "AshWednesday" "Askonsdag" False
    Send AddDay "MaundyThursday" "Skärtorsdagen" False
    Send AddDay "GoodFriday" "Långfredagen" True
    Send AddDay "HolySaturday" "Påskafton" False
    Send AddDay "EasterDay" "Påskdagen" True
    Send AddDay "EasterMonday" "Annandag Påsk" True

    // Vårdagjämning

    // Start of European (Swedish) Summer Time - last Sunday in March (at 1am)
    //
    Send AddDay "EUSummerTimeStart" "Svensk (Europeisk) sommartid börjar" False

    // End of European (Swedish) Summer Time - last Sunday in October (at 1am)
    //
    Send AddDay "EUSummerTimeEnd" "Svensk (Europeisk) sommartid slutar" False

    // Vårdagjämning
    Send AddDay "VernalEquinox" "Vårdagjämning" False

    // Höstdagjämning
    Send AddDay "AutumnalEquinox" "Höstdagjämning" False

    // This day needs to be _after_ the WhitSunday.
    // So when WhitSunday falls on the last Sunday in May,
    // only the WhitSunday will get generated. Else the
    // Mother's Day would show up at that same day.
    Send AddDay "MothersDay" "Mors Dag" False
    Send AddDay "FathersDay" "Fars Dag" False

    // This needs to be after all easter days.
    // So when April fools day falls on one of the easter days,
    // an easter day will be returned instead. (More imporant)
    Send AddDay "AprilFoolsDay" "Första April! (April, april!)" False

End_Object
