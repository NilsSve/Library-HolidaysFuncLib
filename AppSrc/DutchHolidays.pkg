//****************************************************************************
// $Module type: Package
// $Module name: DutchHolidays.pkg
// $Author     : Nils Svedmyr / Peter van Mil
// Created     : 2010-03-22 @ 06:23
//
// Description : Function that returns the name of Swedish holidays from a date variable.
//
// Note        : To create a similar package for another country, copy the function below and
//               simply change the name and wordings and possibly also what should constitute the holidays
//               for your country. All the underlying holiday functions can be found in oCalendarHolidays.pkg
//               The HolidayName function is used by the Holidays.vw sample view; the oCreateDates_bp business process.
//
// $Rev History:
//    2010-03-22 Module header created
//
//    2010-03-30 Added functionality to make it easier to add just about any 'special day'
//               that you might want to add to a Is????Holiday function. (were ???? is the country name)
//               Look for comment: *** New 2010-03-30 NGS ***
//    2010-12-20 New package based on SwedishHolidays.pkg
//    2013-05-01 Queensday on 30th of april changed in kingsday on 27th of april.
//
//
//****************************************************************************
Use cNationalHolidays.pkg

Object oDutchHolidays is a cNationalHolidays

    // A 2-character ISO_Short string, according to the list:
    // https://www.iso.org/obp/ui/#search/code/
    Set psISO_Short to "NL"
    Set psLocaleName to "nl-NL"    // the month and day names in the country's language

    // The calendar's words in the country's language (cCalendarHolidays' CountryWords; English where not set).
    Set psTextWeek             to "Wk"
    Set psTextWorkingDaysNote  to "%1 werkdagen"
    Set psTextHoliday          to "Feestdag, vrij"
    Set psTextHolidayWeekend   to "Feestdag in het weekend"
    Set psTextSpecial          to "Bijzondere dag, werkdag"
    Set psTextSpecialWeekend   to "Bijzondere dag, weekend"
    Set psTextWeekend          to "Elke week vrij"
    Set psTextClosed           to "Gesloten"
    Set psTextClosedDay        to "Sluitingsdag"
    Set psTextWorkingDay       to "Werkdag"

    // THE DAYS (2026-11-26): looked up in this order - the first that falls on a date names it, so when two fall on
    // the same date the one listed first wins. AddDay gives a day by one of the library's date functions
    // (oCalendarHolidays.pkg), AddFixedDay by its month and day; the last argument is True for an official holiday -
    // a day off by law - and False for a special day that is not. HolidayName and IsDateAHoliday both read this list
    // (cNationalHolidays.pkg).

    // *** Fixed Holidays ***
    Send AddDay "NewYearsEve" "Oudejaarsavond" False
    Send AddDay "NewYearsDay" "Nieuwjaarsdag" True
    Send AddDay "Epiphany" "Driekoningen" False
    Send AddDay "ValentinesDay" "Valentijnsdag" False
    Send AddDay "LaborDay" "Dag van de Arbeid" False
    Send AddDay "Halloween" "Halloween" False
    Send AddDay "ChristmasEve" "Kerstavond" False
    Send AddDay "ChristmasDay" "Eerste Kerstdag" True
    Send AddDay "SecondDayChristmas" "Tweede Kerstdag" True
    Send AddDay "NationalDay" "Koninginnedag" True  // 30-04
    Send SetDayYears 0 2013
    Send AddDay "NationalDay" "Koningsdag" True     // 27-04
    Send SetDayYears 2014 0

    // This is an example on how to add a 'holiday'
    // for any special day that you might
    // want to include in a e.g. holidays date table.
    // The International Women's Day falls each year on the 8th of March.
    Send AddFixedDay 3 8 "Internationale vrouwendag" False  // 8th of March.
    Send AddFixedDay 5 4 "Dodenherdenking" False  // 4th of May.

    // A national holiday by law (Algemene termijnenwet); whether it is a day off is up to the employer.
    Send AddFixedDay 5 5 "Bevrijdingsdag" True  // 5th of May.

    // *** Movable holidays ***
    // Easter functions at the bottom; they are the most complicated to calculate.
    Send AddDay "PalmSunday" "Palmzondag" False
    Send AddDay "AscensionDay" "Hemelvaartsdag" True
    Send AddDay "WhitSunday" "Eerste Pinksterdag" True
    Send AddDay "WhitMonday" "Tweede Pinksterdag" True
    Send AddDay "AllSaintsDay" "Allerheiligen" False
    Send AddDay "MaundyThursday" "Witte Donderdag" False
    Send AddDay "GoodFriday" "Goede Vrijdag" False

    //  Get HolySaturday iYear sISO_Short to dHolidayDate
    //  If (dInDate = dHolidayDate) Begin
    //      Move False to bOfficialHoliday
    //      Function_Return "Paaszaterdag"
    //  End
    Send AddDay "EasterDay" "Eerste Paasdag" True
    Send AddDay "EasterMonday" "Tweede Paasdag" True

    // Start of European Summer Time - last Sunday in March (at 1am)
    //
    Send AddDay "EUSummerTimeStart" "Begin zomertijd" False

    // End of European Summer Time - last Sunday in October (at 1am)
    //
    Send AddDay "EUSummerTimeEnd" "Einde zomertijd" False

    // Sprint Equinox
    Send AddDay "VernalEquinox" "Lente-equinox" False

    // Autumn Equinox
    Send AddDay "AutumnalEquinox" "Herfst-equinox" False

    // This day needs to be _after_ the WhitSunday.
    // So when WhitSunday falls on the last Sunday in May,
    // only the WhitSunday will get generated. Else the
    // Mother's Day would show up at that same day.
    Send AddDay "MothersDay" "Moederdag" False
    Send AddDay "FathersDay" "Vaderdag" False
    
End_Object
